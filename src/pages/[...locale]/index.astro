---
import Home from '../../components/pages/Home.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../consts';
import { staticAlternates } from '../../lib/posts';
import { localePaths } from '../../lib/routes';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  title={SITE.title}
  description={SITE.description[locale]}
  locale={locale}
  alternates={staticAlternates('/')}
>
  <Home locale={locale} />
</BaseLayout>
