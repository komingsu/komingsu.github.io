---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../consts';
import { useTranslations } from '../../i18n/ui';
import { staticAlternates } from '../../lib/posts';
import { localePaths } from '../../lib/routes';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  title={t('about.title')}
  description={SITE.description[locale]}
  locale={locale}
  alternates={staticAlternates('/about')}
>
  <div class="shell">
    <header class="page-header">
      <h1 class="page-header__title">{t('about.title')}</h1>
    </header>
  </div>

  <div class="prose">
    {
      locale === 'ko' ? (
        <>
          <p>
            안녕하세요, <strong>고민수</strong>입니다. 과학·수학 원리를 딥러닝에 접목해
            산업·공학 문제를 푸는 데 관심이 있는 AI 연구자입니다.
          </p>
          <h2>이 블로그에 대해</h2>
          <p>
            논문을 읽고 나면 수식은 이해했는데 감각이 안 잡히는 경우가 많습니다. 이 블로그는
            그 간격을 메우려고 만들었습니다. 값을 직접 바꿔 보고, 경로가 어떻게 달라지는지
            눈으로 확인할 수 있는 글을 씁니다.
          </p>
          <h2>연락</h2>
          <p>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.github}>GitHub</a>
          </p>
        </>
      ) : (
        <>
          <p>
            I am <strong>Ko Minsu</strong>, an AI researcher interested in folding scientific and
            mathematical structure into deep learning to address industrial and engineering
            problems.
          </p>
          <h2>About this blog</h2>
          <p>
            After reading a paper you often understand the equations without having any feel for
            them. This blog exists to close that gap: posts here let you change the numbers
            yourself and watch what the trajectory does.
          </p>
          <h2>Contact</h2>
          <p>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.github}>GitHub</a>
          </p>
        </>
      )
    }
  </div>
</BaseLayout>
